{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/agent-launch-guard/claude_pretooluse.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
