{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.codex/hooks/scope-lock/codex_prompt_scope.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.codex/hooks/scope-lock/codex_pretool_scope.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
