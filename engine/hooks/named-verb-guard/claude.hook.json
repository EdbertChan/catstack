{
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/named-verb-guard/claude_stop_check.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "subagent_stop": {
    "dispatch": true
  }
}
