{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.codex/hooks/skill-usage-log/codex_pretooluse.py",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.codex/hooks/skill-usage-log/codex_prompt_submit.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
