#!/usr/bin/env bash
# catstack-pre-push-review-unit
#
# Refuses a branch push whose diff from its merge-base with origin/main mixes
# review units. The unit table lives in engine/skills/make-pr/scripts/preflight.py;
# this hook runs the origin/main copy of it, so a branch cannot loosen its own check.
# A check that cannot run (no origin/main, no preflight, no shared history)
# refuses the push too. Install with scripts/install-git-hooks.sh.
set -euo pipefail

preflight=""
names=""
cleanup() {
  rm -f "$preflight" "$names"
}
trap cleanup EXIT

bypass="push with --no-verify to bypass"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ $local_sha =~ ^0+$ ]]; then
    continue
  fi
  # git reports `git push origin HEAD:topic` with local ref HEAD, so the
  # remote ref is what says a branch is being pushed.
  if [[ $remote_ref != refs/heads/* ]]; then
    continue
  fi

  if [[ -z $preflight ]]; then
    if ! git rev-parse --verify -q refs/remotes/origin/main >/dev/null; then
      echo "pre-push: UNCHECKED: origin/main not found; run git fetch origin main, or push with --no-verify to bypass" >&2
      exit 1
    fi
    preflight=$(mktemp)
    names=$(mktemp)
    if ! git show origin/main:engine/skills/make-pr/scripts/preflight.py >"$preflight"; then
      echo "pre-push: UNCHECKED: origin/main has no engine/skills/make-pr/scripts/preflight.py; $bypass" >&2
      exit 1
    fi
  fi

  if ! mb=$(git merge-base origin/main "$local_sha"); then
    echo "pre-push: UNCHECKED: $local_ref shares no history with origin/main; $bypass" >&2
    exit 1
  fi
  if ! git diff --name-only -z "$mb" "$local_sha" >"$names"; then
    echo "pre-push: UNCHECKED: git diff $mb $local_sha failed for $local_ref; $bypass" >&2
    exit 1
  fi
  mapfile -d '' files <"$names"
  if [[ ${#files[@]} -eq 0 ]]; then
    continue
  fi

  rc=0
  out=$(python3 "$preflight" --dry-run --paths "${files[@]}" 2>&1) || rc=$?
  if [[ $rc -eq 0 ]]; then
    continue
  fi
  printf '%s\n' "$out" >&2
  if [[ $rc -eq 1 ]]; then
    echo "pre-push: refusing $local_ref: make one branch per review unit (git push --no-verify bypasses this check)" >&2
  else
    echo "pre-push: UNCHECKED: preflight exited $rc for $local_ref; $bypass" >&2
  fi
  exit 1
done

exit 0
